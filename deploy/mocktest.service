[Unit]
Description=Multilevel Mock Test Flask App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mocktest
Environment="PATH=/var/www/mocktest/venv/bin"
ExecStart=/var/www/mocktest/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
